# Requested configuration for the evidence-only C3 TDX kernel.
# Feed this to KCONFIG_ALLCONFIG with ARCH=x86 allnoconfig, then olddefconfig.
# This fragment is not an effective configuration or a boot qualification.

# Native x86-64 UEFI/TDX and public interrupt/timer infrastructure.
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_CPU_SUP_INTEL=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_X86_X2APIC=y
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_INTEL_TDX_GUEST=y
CONFIG_SWIOTLB=y
CONFIG_HIGH_RES_TIMERS=y

# Built-in devices: no loadable module or module-signing-key dependency.
# CONFIG_MODULES is not set
CONFIG_BLOCK=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NET=y
CONFIG_INET=y
# CONFIG_IPV6 is not set
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
# CONFIG_IP_PNP_BOOTP is not set
# CONFIG_IP_PNP_RARP is not set
CONFIG_SYN_COOKIES=y

# The single UKI binds the fixed root hash and initramfs. Runtime root storage
# is read-only dm-verity; the pre-listener full-read check is still mandatory.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EFI_PARTITION=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_TDX_GUEST_DRIVER=y
CONFIG_TSM_REPORTS=y

# Userland, bounded async I/O, and the eventual service confinement policy.
CONFIG_BINFMT_ELF=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_FUTEX_PI=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSCTL=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_PRINTK=y

# Preserve the effective config inside the kernel for artifact comparison.
CONFIG_IKCONFIG=y
# CONFIG_IKCONFIG_PROC is not set
CONFIG_LOCALVERSION="-zaino-boot-spike"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BUILD_SALT="zaino-boot-spike-v1"

# No alternate execution, memory export, administration console, or sleep path.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_CORE is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM_SLEEP is not set
# CONFIG_SWAP is not set
# CONFIG_COREDUMP is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_PROC_VMCORE is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVKMEM is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_BINFMT_SCRIPT is not set
# CONFIG_USER_NS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_TTY is not set
# CONFIG_SERIAL_8250 is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_KGDB is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_RUST is not set
